<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    ExtensionBundleId="com.scctlm.foto.bundle" ExtensionBundleVersion="0.2.2" Version="6.0">
    <ExtensionList>
        <Extension Id="com.scctlm.foto.panel" Version="0.2.2" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHXS" Version="14.0" />
            <Host Name="PHSP" Version="14.0" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="6.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.scctlm.foto.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <!-- Không khai báo ScriptPath: lõi ExtendScript do js/panel.js nạp
                         với đường dẫn lấy từ CEP (getSystemPath). Tránh trường hợp CEP trả
                         $.fileName dạng "/e/...%20..." hoặc chỉ "loader.jsx" -> IOError. -->
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>SCCTLM_Foto</Menu>
                    <Geometry>
                        <Size><Height>580</Height><Width>300</Width></Size>
                        <MaxSize><Height>2000</Height><Width>600</Width></MaxSize>
                        <MinSize><Height>300</Height><Width>300</Width></MinSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./img/icon-large.png</Icon>
                        <Icon Type="DarkNormal">./img/icon-large.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
    <Author>SCCTLM</Author>
    <Abstract>SCCTLM_Foto - panel retouch cho Photoshop.</Abstract>
    <HostList />
</ExtensionManifest>
